<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rpp_cpp</name>
  <version>0.0.0</version>
  <description>C++ RPP runtime with Cap'n Proto 1.1.0 generated interfaces.</description>
  <maintainer email="luka.mandic@fer.hr">luka</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>capnproto</build_depend>
  <build_depend>nlohmann_json</build_depend>
  <build_depend>pybind11_vendor</build_depend>
  <build_depend>python3-dev</build_depend>

  <build_export_depend>capnproto</build_export_depend>
  <build_export_depend>nlohmann_json</build_export_depend>

  <exec_depend>capnproto</exec_depend>
  <exec_depend>nlohmann_json</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rpp_cli</test_depend>
  <test_depend>rpp_testing</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
